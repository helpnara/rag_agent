# 완전 로컬 + 폐쇄망 구성 - 외부 API 키 불필요.

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
DOCS_DIR=./docs

# Qdrant 접속 방식
#   server : 로컬 Docker Qdrant (기본, QDRANT_URL 사용)
#   path   : Docker 없이 로컬 파일에 저장 (개인 PC 테스트에 편리)
#   memory : 프로세스 메모리 (재시작 시 소실)
QDRANT_MODE=server
QDRANT_PATH=./qdrant_local

# 임베딩 모델은 로컬 폴더에서 로드 (반입한 폴더 경로)
EMBEDDING_MODEL_PATH=./models/bge-m3

# 로컬 LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- LLM 동작 모드 ---
# local    = 완전 로컬(Ollama). 폐쇄망 기본·권장.
# external = 외부 생성형 LLM API(OpenAI 호환).
#            ⚠️ 질문 + 검색된 사내 문서 컨텍스트가 외부로 전송됩니다.
#               폐쇄망 보안 정책을 검토한 뒤에만 사용하세요.
LLM_MODE=local

# --- 외부 LLM (OpenAI 호환 엔드포인트) ---
# EXTERNAL_API_KEY 가 비어 있으면 외부 모드는 UI에서 비활성화됩니다.
# OpenAI 공식 외에 vLLM / OpenRouter 등 OpenAI 호환 서버도 base_url만 바꾸면 사용 가능.
EXTERNAL_BASE_URL=https://api.openai.com/v1
EXTERNAL_API_KEY=
EXTERNAL_MODEL=gpt-4o-mini

# 임베딩 실행 장치: 기본 cpu. NVIDIA GPU가 있으면 cuda 로 변경.
DEVICE=cpu
