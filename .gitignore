# 가상환경
.venv/
.venv-demo/
venv/

# 파이썬 캐시
__pycache__/
*.pyc

# 환경변수 (키·경로 등 로컬 설정)
.env

# Streamlit 비밀값 (예시 파일만 커밋)
.streamlit/secrets.toml

# 모델 파일 (용량이 크고 반입 절차로 별도 관리)
models/

# 벡터DB 저장소
qdrant_storage/
qdrant_local/

# fastembed 모델 캐시 (데모)
.fastembed_cache/

# 오프라인 반입용 산출물
wheels/
*.tar

# 업로드된 문서 (docs 폴더 내용은 커밋하지 않음, 폴더 자체는 유지)
docs/*
!docs/.gitkeep

# OS
.DS_Store
Thumbs.db
